{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerconexo-m6-local",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "ADMISSION", "class_name": "AdmissionGate" }
    ]
  },
  "migrations": [{ "tag": "m6-1", "new_sqlite_classes": ["Room", "AdmissionGate"] }],
  "vars": {
    "LOCAL_DEMO": "true",
    "ALLOWED_ORIGINS": "http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:8788,http://localhost:8788,http://127.0.0.1:8789,http://127.0.0.1:8790,http://localhost:8790"
  },
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
