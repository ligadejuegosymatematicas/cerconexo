{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerconexo-m6-experimental",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": { "directory": "./.experimental/public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "ADMISSION", "class_name": "AdmissionGate" }] },
  "migrations": [{ "tag": "m6-1", "new_sqlite_classes": ["Room", "AdmissionGate"] }],
  "vars": { "INTEGRATED_SITE": "true", "LOCAL_DEMO": "true", "PUBLIC_DEMO": "false", "PUBLIC_ORIGIN": "", "ALLOWED_ORIGINS": "http://127.0.0.1:8800" },
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 8800 }
}
