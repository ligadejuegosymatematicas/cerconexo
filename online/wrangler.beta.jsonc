{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerconexo-m6-beta-staging",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "durable_objects": { "bindings": [{"name":"ROOMS","class_name":"Room"},{"name":"ADMISSION","class_name":"AdmissionGate"}] },
  "migrations": [{"tag":"beta-1","new_sqlite_classes":["Room","AdmissionGate"]}],
  "vars": {
    "SERVICE_MODE":"beta-staging", "PUBLIC_CREATION":"false",
    "BACKEND_ORIGIN":"https://cerconexo-m6-beta-staging.cerconexo-piloto-h89.workers.dev",
    "FRONTEND_ORIGINS":"https://ligadejuegosymatematicas.github.io",
    "ALLOW_LOOPBACK_TESTS":"false", "PUBLIC_DEMO":"false", "LOCAL_DEMO":"false"
  },
  "observability":{"enabled":false}
}
