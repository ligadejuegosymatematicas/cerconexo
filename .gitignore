# Lista explícita de archivos del repositorio. El resto queda solo en este equipo.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/PUBLICACION.md
!/index.html
!/build.py
!/src/
/src/*
!/src/app.mjs
!/src/engine.mjs
!/src/boardTargets.mjs
!/src/styles.css
!/assets/
/assets/*
!/assets/Cerconexo_logo_v3_original.png
!/assets/Cerconexo_wordmark_original.png
!/scripts/
/scripts/*
!/scripts/pages-files.json
!/scripts/build_pages.py
!/tests/
/tests/*
!/tests/engine.test.mjs
!/tests/targets.test.mjs
!/tests/pages.test.mjs
!/tests/pages.browser.cjs
!/tests/pages-server.mjs
!/docs/
/docs/*
!/docs/index.html
!/docs/.nojekyll
!/docs/src/
/docs/src/*
!/docs/src/app.mjs
!/docs/src/engine.mjs
!/docs/src/boardTargets.mjs
!/docs/src/styles.css
!/docs/assets/
/docs/assets/*
!/docs/assets/Cerconexo_wordmark_original.png
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/verificar.yml
